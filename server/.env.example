MONGODB_URI=
PORT=3000
SERVER_HOST=localhost
CORS_ORIGIN=http://localhost:5175
FRONTEND_URL=http://localhost:5175

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Email, option 1: SMTP (works locally and on hosts that allow outgoing mail ports)
MAIL_HOST=
EMAIL_PORT=
MAIL_USER=
MAIL_PASS=

# Email, option 2: Brevo HTTPS API. When BREVO_API_KEY is set it is used instead of SMTP.
# MAIL_FROM must be a sender verified in Brevo; it defaults to MAIL_USER.
BREVO_API_KEY=
MAIL_FROM=

# Language model that writes the insights
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sources. A source without credentials is switched off. Hacker News needs none.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Researches each user may run per day
DAILY_RESEARCH_LIMIT=5
